# dependencies (recreated with `npm install`)
node_modules/

# background server log
server.log
*.log

# system / editor
.DS_Store
.idea/
.vscode/

# local Claude Code settings (per-machine permissions)
.claude/settings.local.json

# screenshots and temporary files of the headless tests (they belong in the scratchpad, not in the project)
shot*.png
*.tmp

# any secrets
.env
.env.*

# static version generated by `npm run build` (a hosted deployment regenerates it on every deploy)
dist/

# local notes for Claude Code (deployment details etc.)
CLAUDE.local.md
